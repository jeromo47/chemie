---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ShieldCheck, Users, Building2, Target } from '@lucide/astro';
---
<BaseLayout
  title="Sobre Grupo Chemie · Distribución química en Almería"
  description="Conoce a Grupo Chemie: distribuidor de productos químicos, biocidas registrados y suministros industriales con sede en Almería."
>
  <section class="section">
    <div class="container-tight max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Quiénes somos</p>
      <h1 class="mt-2 text-4xl md:text-5xl font-extrabold tracking-tight">Grupo Chemie</h1>
      <p class="mt-5 text-lg text-slate-600">
        Empresa almeriense especializada en distribución de productos químicos y suministros industriales.
        Damos servicio a cooperativas agrícolas, industria alimentaria, talleres y hostelería, con asesoramiento
        técnico y cumplimiento normativo en cada referencia.
      </p>
      <p class="mt-3 text-sm text-slate-500">
        <em>[Placeholder — sustituir por texto definitivo sobre la historia de la empresa, equipo y ámbito de trabajo.]</em>
      </p>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-100">
    <div class="container-tight grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <ShieldCheck class="h-7 w-7 text-brand-700" />
        <h3 class="mt-3 font-semibold">Biocidas registrados</h3>
        <p class="mt-1 text-sm text-slate-600">Autorización oficial 12-20/40-06373-HA.</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <Users class="h-7 w-7 text-brand-700" />
        <h3 class="mt-3 font-semibold">Trato técnico</h3>
        <p class="mt-1 text-sm text-slate-600">Comerciales especializados en cada sector.</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <Building2 class="h-7 w-7 text-brand-700" />
        <h3 class="mt-3 font-semibold">Sede en Almería</h3>
        <p class="mt-1 text-sm text-slate-600">Logística local y servicio rápido.</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <Target class="h-7 w-7 text-brand-700" />
        <h3 class="mt-3 font-semibold">Foco B2B</h3>
        <p class="mt-1 text-sm text-slate-600">Cooperativas, industria y profesionales.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-tight max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold">Nuestro compromiso</h2>
      <p class="mt-3 text-slate-600">
        <em>[Placeholder — misión, valores, compromiso ambiental, normativa REACH/CLP, certificaciones, etc.]</em>
      </p>
    </div>
  </section>
</BaseLayout>
