---
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';

// Preselección desde querystring (p.ej. /contacto?sector=cooperativa)
const sectorParam = (Astro.url.searchParams.get('sector') ?? '').toLowerCase();
const sectorPreset =
  sectorParam === 'cooperativa' || sectorParam === 'cooperativas'
    ? 'Cooperativa / manipulado'
    : sectorParam === 'alimentaria'
      ? 'Industria alimentaria'
      : sectorParam === 'hosteleria'
        ? 'Hostelería / colectividades'
        : sectorParam === 'taller' || sectorParam === 'automocion'
          ? 'Taller / automoción'
          : sectorParam === 'construccion'
            ? 'Construcción'
            : sectorParam === 'mantenimiento'
              ? 'Mantenimiento industrial'
              : '';

const inputClass =
  'mt-1 w-full rounded-md border border-line bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted/60 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
---
<form action={endpoint} method="POST" class="grid gap-4">
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">Nombre *</span>
      <input type="text" name="nombre" required autocomplete="name" class={inputClass} />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">Empresa / cooperativa</span>
      <input type="text" name="empresa" autocomplete="organization" class={inputClass} />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">Email *</span>
      <input type="email" name="email" required autocomplete="email" class={inputClass} />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">Teléfono</span>
      <input type="tel" name="telefono" autocomplete="tel" class={inputClass} />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">Sector</span>
      <select name="sector" class={inputClass}>
        <option value="">Selecciona un sector</option>
        <option selected={sectorPreset === 'Cooperativa / manipulado'}>Cooperativa / manipulado</option>
        <option selected={sectorPreset === 'Industria alimentaria'}>Industria alimentaria</option>
        <option selected={sectorPreset === 'Hostelería / colectividades'}>Hostelería / colectividades</option>
        <option selected={sectorPreset === 'Taller / automoción'}>Taller / automoción</option>
        <option selected={sectorPreset === 'Construcción'}>Construcción</option>
        <option selected={sectorPreset === 'Mantenimiento industrial'}>Mantenimiento industrial</option>
        <option>Otro</option>
      </select>
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">Tipo de consulta</span>
      <select name="tipoConsulta" class={inputClass}>
        <option value="">Selecciona</option>
        <option>Presupuesto</option>
        <option>Asesoramiento técnico</option>
        <option>Ficha técnica / seguridad</option>
        <option>Suministro continuado</option>
        <option>Otro</option>
      </select>
    </label>
  </div>

  <label class="block">
    <span class="text-sm font-medium text-ink">Mensaje *</span>
    <textarea name="mensaje" rows="5" required class={inputClass}></textarea>
  </label>

  <label class="flex items-start gap-2 text-sm text-muted">
    <input
      type="checkbox"
      required
      class="mt-1 rounded border-line text-brand-500 focus:ring-brand-500"
    />
    <span>He leído y acepto la <a href="/privacidad" class="text-brand-600 hover:underline">política de privacidad</a>.</span>
  </label>

  <!-- Honeypot anti-spam -->
  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    class="hidden"
    aria-hidden="true"
  />

  <!-- Redirección tras envío -->
  <input type="hidden" name="_subject" value="Nuevo contacto desde grupochemie.com" />

  <div>
    <button type="submit" class="btn-primary">Enviar mensaje</button>
  </div>

  {!endpoint && (
    <p class="text-xs text-brand-700 bg-brand-50 border border-brand-200 rounded-md p-3">
      <strong>Aviso dev:</strong> define <code>PUBLIC_FORMSPREE_ENDPOINT</code> en <code>.env</code> para que el formulario envíe datos.
    </p>
  )}
</form>
