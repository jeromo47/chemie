---
import { MessageCircle } from '@lucide/astro';
import { site } from '../config/site';

const href = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.defaultMessage)}`;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-transform hover:scale-105 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#25D366]"
>
  <MessageCircle class="h-7 w-7" />
  <span class="sr-only">WhatsApp</span>
</a>
