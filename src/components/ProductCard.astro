---
import { Image } from 'astro:assets';
import { FlaskConical, ShieldCheck, ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { nombre, ref, categoria, categoriaPadre, descripcion, imagen, registroBiocida } = product.data;
---
<a
  href={`/productos/${product.slug}`}
  class="group card-hover relative flex flex-col overflow-hidden"
>
  <div class="aspect-[4/3] w-full bg-surface-soft flex items-center justify-center overflow-hidden border-b border-line">
    {imagen ? (
      <Image
        src={imagen}
        alt={nombre}
        width={600}
        height={450}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <FlaskConical class="h-12 w-12 text-brand-200" stroke-width={1.5} />
    )}
  </div>
  <div class="flex flex-col gap-1.5 p-5 flex-1">
    <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-muted">
      <span>{categoriaPadre}</span>
      <span class="text-line">/</span>
      <span>{categoria}</span>
    </div>
    <h3 class="text-base font-semibold text-ink group-hover:text-brand-600 transition-colors">
      {nombre}
    </h3>
    <p class="text-xs text-muted">Ref. {ref}</p>
    <p class="text-sm text-muted line-clamp-2 mt-1">{descripcion}</p>
    {registroBiocida && (
      <span class="badge-brand mt-2">
        <ShieldCheck class="h-3 w-3" />
        Biocida {registroBiocida}
      </span>
    )}
    <span class="mt-auto pt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand-600 opacity-0 translate-x-[-4px] group-hover:opacity-100 group-hover:translate-x-0 transition">
      Ver ficha <ArrowUpRight class="h-3.5 w-3.5" />
    </span>
  </div>
</a>
