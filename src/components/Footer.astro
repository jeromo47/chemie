---
import { Mail, Phone, MapPin } from '@lucide/astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container-tight py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-brand-800 text-white font-bold">C</span>
        <span class="text-lg font-bold text-slate-900">Grupo Chemie</span>
      </div>
      <p class="mt-3 text-sm text-slate-600 max-w-sm">
        Distribución de productos químicos y suministros industriales en Almería.
        Soluciones para cooperativas agrícolas, industria alimentaria, talleres y hostelería.
      </p>
      <p class="mt-3 text-xs text-slate-500">
        Registro Oficial de Biocidas <strong class="text-slate-700">12-20/40-06373-HA</strong>
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900">Contacto</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li class="flex items-start gap-2">
          <MapPin class="h-4 w-4 mt-0.5 text-brand-700" />
          <span>Almería<br /><span class="text-slate-400">[Dirección completa — placeholder]</span></span>
        </li>
        <li class="flex items-center gap-2">
          <Phone class="h-4 w-4 text-brand-700" />
          <a href="tel:+34609662482" class="hover:text-brand-800">609 662 482</a>
        </li>
        <li class="flex items-center gap-2">
          <Mail class="h-4 w-4 text-brand-700" />
          <a href="mailto:info@grupochemie.com" class="hover:text-brand-800">info@grupochemie.com</a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900">Enlaces</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="/productos" class="hover:text-brand-800">Productos</a></li>
        <li><a href="/cooperativas" class="hover:text-brand-800">Cooperativas</a></li>
        <li><a href="/sectores" class="hover:text-brand-800">Sectores</a></li>
        <li><a href="/contacto" class="hover:text-brand-800">Contacto</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200">
    <div class="container-tight py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <p>&copy; {year} Grupo Chemie. Todos los derechos reservados.</p>
      <p>Distribución de productos químicos · Almería</p>
    </div>
  </div>
</footer>
