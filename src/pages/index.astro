---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { ShieldCheck, Truck, HeartHandshake, Beaker, ArrowRight, CircleCheck } from '@lucide/astro';

const productos = (await getCollection('products'))
  .filter((p) => p.data.destacado)
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .slice(0, 6);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Grupo Chemie',
  description:
    'Distribuidor de productos químicos y suministros industriales en Almería, especializado en cooperativas agrícolas.',
  url: 'https://grupochemie.com',
  telephone: '+34609662482',
  email: 'info@grupochemie.com',
  areaServed: 'Almería, España',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Almería',
    addressCountry: 'ES',
  },
};
---
<BaseLayout
  title="Grupo Chemie · Productos químicos y suministros industriales en Almería"
  description="Distribuidor de productos químicos, biocidas registrados y suministros industriales para cooperativas agrícolas, industria alimentaria, talleres y hostelería en Almería."
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
    <div class="container-tight section grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 border border-brand-100">
          <ShieldCheck class="h-3.5 w-3.5" /> Empresa con Registro Oficial de Biocidas
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900">
          Productos químicos y suministros industriales para <span class="text-brand-800">cooperativas y empresas</span> de Almería.
        </h1>
        <p class="mt-5 text-lg text-slate-600 max-w-xl">
          En Grupo Chemie distribuimos biocidas, detergentes industriales, EPIs y consumibles técnicos con asesoramiento profesional y entrega rápida.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/productos" class="btn-primary">Ver catálogo <ArrowRight class="h-4 w-4" /></a>
          <a href="/contacto" class="btn-outline">Solicitar presupuesto</a>
        </div>
      </div>

      <div class="relative">
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-8">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Registro Oficial</p>
          <p class="mt-2 text-2xl md:text-3xl font-bold text-slate-900">
            Nº Biocidas
          </p>
          <p class="mt-1 text-3xl md:text-4xl font-black text-brand-800 tracking-tight">
            12-20/40-06373-HA
          </p>
          <p class="mt-4 text-sm text-slate-600">
            Autorización oficial que garantiza el cumplimiento normativo en la comercialización y aplicación de productos biocidas de uso profesional.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-slate-700">
            <li class="flex items-center gap-2"><CircleCheck class="h-4 w-4 text-brand-700" /> Asesoramiento técnico especializado</li>
            <li class="flex items-center gap-2"><CircleCheck class="h-4 w-4 text-brand-700" /> Entrega en Almería y provincia</li>
            <li class="flex items-center gap-2"><CircleCheck class="h-4 w-4 text-brand-700" /> Fichas técnicas y de seguridad</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="section border-t border-slate-100">
    <div class="container-tight">
      <h2 class="text-2xl md:text-3xl font-bold">Soluciones B2B con respaldo técnico</h2>
      <p class="mt-2 text-slate-600 max-w-2xl">
        Trabajamos con cooperativas agrícolas, industria alimentaria, talleres y hostelería. Seleccionamos el producto adecuado y acompañamos en su uso.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 p-6">
          <Beaker class="h-7 w-7 text-brand-700" />
          <h3 class="mt-3 font-semibold">Catálogo técnico</h3>
          <p class="mt-1 text-sm text-slate-600">Biocidas registrados, detergencia industrial, EPIs y consumibles.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-6">
          <Truck class="h-7 w-7 text-brand-700" />
          <h3 class="mt-3 font-semibold">Logística local</h3>
          <p class="mt-1 text-sm text-slate-600">Almacén propio en Almería y servicio a cooperativas y empresas del entorno.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-6">
          <HeartHandshake class="h-7 w-7 text-brand-700" />
          <h3 class="mt-3 font-semibold">Trato directo</h3>
          <p class="mt-1 text-sm text-slate-600">Comercial técnico de referencia y condiciones adaptadas a cada cliente.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTOS DESTACADOS -->
  {productos.length > 0 && (
    <section class="section bg-slate-50 border-t border-slate-100">
      <div class="container-tight">
        <div class="flex items-end justify-between gap-4 flex-wrap">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold">Productos destacados</h2>
            <p class="mt-2 text-slate-600">Selección representativa del catálogo.</p>
          </div>
          <a href="/productos" class="text-sm font-semibold text-brand-800 hover:underline inline-flex items-center gap-1">
            Ver todos <ArrowRight class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {productos.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section">
    <div class="container-tight">
      <div class="rounded-2xl bg-brand-800 text-white p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-white">¿Trabajas en una cooperativa?</h2>
          <p class="mt-2 text-brand-50/90 max-w-xl">
            Tenemos una línea específica para cooperativas agrícolas: higiene, desinfección, detergencia CIP y consumibles.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/cooperativas" class="btn bg-white text-brand-800 hover:bg-brand-50">Ver línea cooperativas</a>
          <a href="/contacto" class="btn border border-white/30 text-white hover:bg-white/10">Contactar</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
