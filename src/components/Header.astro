---
import { Menu, X, Phone, Clock } from '@lucide/astro';
import Logo from './Logo.astro';
import { site } from '../config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!-- Top-bar (desktop) -->
<div class="hidden md:block bg-ink text-white/90 text-xs">
  <div class="container-tight flex items-center justify-between h-9">
    <div class="flex items-center gap-5">
      <span class="inline-flex items-center gap-1.5">
        <Clock class="h-3.5 w-3.5 text-brand-400" />
        {site.horario.display}
      </span>
      <span class="text-white/30">·</span>
      <a href={`tel:${site.phone.tel}`} class="inline-flex items-center gap-1.5 hover:text-brand-400 transition-colors">
        <Phone class="h-3.5 w-3.5 text-brand-400" />
        {site.phone.display}
      </a>
      <span class="text-white/30">·</span>
      <a href={`mailto:${site.email}`} class="hover:text-brand-400 transition-colors">
        {site.email}
      </a>
    </div>
    <div class="text-white/70">
      Registro de Biocidas <span class="text-white font-medium">{site.registroBiocidas}</span>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/80">
  <div class="container-tight flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label={`${site.name} · Inicio`}>
      <Logo variant="full" class="h-9 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Principal">
      {site.nav.map(({ href, label }) => {
        const active = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'text-sm font-medium transition-colors',
              active ? 'text-brand-600' : 'text-ink hover:text-brand-600',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
      <a href="/contacto" class="btn-primary">Contacto</a>
    </nav>

    <button
      id="nav-toggle"
      class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-ink hover:bg-surface-soft"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Menu class="h-6 w-6" data-icon="menu" />
      <X class="h-6 w-6 hidden" data-icon="close" />
    </button>
  </div>

  <div id="mobile-nav" class="md:hidden hidden border-t border-line bg-surface">
    <nav class="container-tight flex flex-col py-4 gap-1" aria-label="Móvil">
      {site.nav.map(({ href, label }) => (
        <a href={href} class="py-2 text-ink hover:text-brand-600 font-medium">{label}</a>
      ))}
      <a href="/contacto" class="btn-primary mt-2 self-start">Contacto</a>
      <div class="mt-4 pt-4 border-t border-line text-sm text-muted flex flex-col gap-1.5">
        <a href={`tel:${site.phone.tel}`} class="inline-flex items-center gap-2">
          <Phone class="h-4 w-4 text-brand-500" />{site.phone.display}
        </a>
        <span class="inline-flex items-center gap-2">
          <Clock class="h-4 w-4 text-brand-500" />{site.horario.display}
        </span>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const menuIcon = btn?.querySelector('[data-icon="menu"]');
  const closeIcon = btn?.querySelector('[data-icon="close"]');
  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });
</script>
