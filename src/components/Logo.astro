---
export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
const src = variant === 'mark' ? '/logo-mark.svg' : '/logo.svg';
const width = variant === 'mark' ? 40 : 160;
const height = variant === 'mark' ? 40 : 40;
---
<img
  src={src}
  alt="Grupo Chemie"
  width={width}
  height={height}
  class={className}
  decoding="async"
  loading="eager"
/>
