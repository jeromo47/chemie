---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Factory,
  Utensils,
  Wrench,
  ChefHat,
  HardHat,
  Layers,
  ArrowRight,
} from '@lucide/astro';
import { site } from '../config/site';

const sectores = (await getCollection('sectors')).sort(
  (a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99),
);

const iconMap: Record<string, typeof Factory> = {
  factory: Factory,
  utensils: Utensils,
  wrench: Wrench,
  'chef-hat': ChefHat,
  'hard-hat': HardHat,
};
---
<BaseLayout
  title={`Sectores · ${site.name}`}
  description="Industria alimentaria, hostelería, colectividades, mantenimiento, automoción, construcción y entornos industriales."
>
  <section class="border-b border-line bg-surface-soft">
    <div class="container-tight py-14 md:py-20 max-w-3xl">
      <p class="label-muted">Sectores</p>
      <h1 class="mt-2 text-4xl md:text-5xl font-extrabold tracking-tight text-ink">
        Trabajamos con
      </h1>
      <p class="mt-4 text-muted">
        Trabajamos con industria alimentaria, hostelería, colectividades, mantenimiento, automoción, construcción y entornos industriales que requieren producto técnico y suministro profesional.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-tight">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {sectores.map((s) => {
          const Icon = iconMap[s.data.icono ?? ''] ?? Layers;
          return (
            <article class="card-hover p-6 flex flex-col">
              <Icon class="h-8 w-8 text-brand-500" stroke-width={1.6} />
              <h2 class="mt-4 text-lg font-semibold text-ink">{s.data.nombre}</h2>
              <p class="mt-2 text-sm text-muted flex-1">{s.data.descripcion}</p>
              <a
                href="/contacto"
                class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:underline"
              >
                Consultar <ArrowRight class="h-3.5 w-3.5" />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
